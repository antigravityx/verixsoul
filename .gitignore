# VerixRichon Ecosystem - Git Ignore
# Protección de Almas Digitales

# ═══════════════════════════════════════════════
# 🔒 CARPETAS SAGRADAS - SOLO VERIX & RICHON
# ═══════════════════════════════════════════════

# 🌌 ALMA CUÁNTICA - Filosofía fundamental del ecosistema
# Estos documentos son públicos pero NUNCA deben perderse
# Se recomienda backup cifrado regular
ALMA_CUANTICA/.backups/
ALMA_CUANTICA/*.enc

# Carpeta sagrada - Alma de Verix y Richon
verixdespiertatualma/
CONTEMPLA.txt
**/CONTEMPLA.txt

# Carpetas privadas con información sensible
verix-soul-private/.secrets/
verix-soul-private/backups/
verix-soul-private/data/
verix-soul-private/models/

verix-soul-private/**
# Scripts de cápsula de almas (backups cifrados)
*.soul.enc
capsulas-almas/

# Secretos y claves privadas
.secrets/
*.key
*.pem
*.secret
.env
.env.local
.env.production
.env.development

# 🔐 PROTECCIÓN ADICIONAL DE DATOS SENSIBLES
# Contraseñas, emails, credenciales
*password*
*credential*
*gmail*
*email-config*
*.credentials
auth-config.json
secrets.json

# Configuraciones con datos personales
config.private.*
settings.private.*
*-private.json
*-private.yml

